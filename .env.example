# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Secret key for JWT tokens (generate a random string)
SECRET_KEY=your-secret-key-here

# Base URL of the deployed app
BASE_URL=http://localhost:8000

# PayPal API (https://developer.paypal.com/dashboard/applications)
# Use sandbox for testing, live for production
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# For production: PAYPAL_BASE_URL=https://api-m.paypal.com

# Wave Accounting (https://developer.waveapps.com/)
WAVE_API_TOKEN=your-wave-api-token
WAVE_BUSINESS_ID=your-wave-business-id
